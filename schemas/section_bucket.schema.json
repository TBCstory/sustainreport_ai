{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sustainreport_ai/schemas/section_bucket.schema.json",
  "$defs": {
    "evidence_item": {
      "type": "object",
      "required": [
        "item_id",
        "file_id",
        "segment_id",
        "relevance_score",
        "extract_confidence",
        "used_in_draft"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^EV-\\d{4}$"
        },
        "file_id": {
          "type": "string",
          "pattern": "^F-\\d{4}$"
        },
        "segment_id": {
          "type": "string",
          "pattern": "^SEG-\\d{5}$"
        },
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extract_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "used_in_draft": {
          "type": "boolean"
        },
        "quote_excerpt": {
          "type": ["string", "null"]
        }
      }
    },
    "bucket": {
      "type": "object",
      "required": [
        "bucket_id",
        "section_id",
        "bucket_type",
        "evidence_items",
        "total_confidence",
        "coverage_ratio",
        "created_by",
        "created_at"
      ],
      "properties": {
        "bucket_id": {
          "type": "string",
          "pattern": "^BKT-\\d{4}$"
        },
        "section_id": {
          "type": "string",
          "pattern": "^SEC-\\d+(\\.\\d+)*$"
        },
        "bucket_type": {
          "type": "string",
          "enum": ["primary", "secondary", "contextual", "counterevidence"]
        },
        "evidence_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "total_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "type": "object",
  "required": ["bucket_version", "project_id", "buckets"],
  "properties": {
    "bucket_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-\\d{4}-[A-Z]+-\\d{3}$"
    },
    "buckets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bucket"
      }
    }
  }
}
