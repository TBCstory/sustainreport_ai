{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sustainreport_ai/schemas/writing_blueprint.schema.json",
  "title": "Writing Blueprint",
  "description": "섹션별 실행 계약서. 깊이, 방식, 제약, 불확실성 처리 정책을 정의한다.",
  "type": "object",
  "required": ["blueprint_version", "project_id", "sections"],
  "properties": {
    "blueprint_version": { "type": "string" },
    "project_id": { "type": "string", "pattern": "^PRJ-\\d{4}-[A-Z]+-\\d{3}$" },
    "approved": { "type": "boolean", "default": false },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section_spec" }
    }
  },
  "$defs": {
    "section_spec": {
      "type": "object",
      "required": [
        "section_id",
        "heading_ko",
        "depth_level",
        "writing_approach",
        "flexibility_mode",
        "fallback_if_evidence_missing"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^SEC-\\d+(\\.\\d+)*$",
          "description": "고정 구조 ID. 한번 부여되면 변경하지 않음."
        },
        "heading_ko": { "type": "string" },
        "depth_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "1=개요(100-300w), 2=표준(300-800w), 3=상세(800-1500w), 4=종합(1500w+)"
        },
        "writing_approach": {
          "type": "string",
          "enum": [
            "narrative",
            "data_table_with_narrative",
            "data_table_only",
            "policy_description",
            "case_study",
            "mixed"
          ]
        },
        "expected_length_range": {
          "type": "object",
          "properties": {
            "min_words": { "type": "integer" },
            "max_words": { "type": "integer" }
          },
          "required": ["min_words", "max_words"]
        },
        "required_subsections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "framework_disclosures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "이 섹션이 커버해야 하는 프레임워크 공시 항목 (예: GRI 305-1)"
        },
        "writing_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tone": {
          "type": "string",
          "enum": [
            "formal_technical",
            "formal_general",
            "accessible",
            "executive_summary"
          ]
        },
        "flexibility_mode": {
          "type": "string",
          "enum": ["rigid", "flex", "manual"],
          "description": "rigid=템플릿 기반, flex=자유 초안, manual=사람 작성"
        },
        "model_recommendation": {
          "type": ["string", "null"],
          "description": "이 섹션에 권장하는 모델 (null이면 기본 정책 따름)"
        },
        "required_evidence_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "numeric_dependency_level": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "default": "medium",
          "description": "high=모든 수치 필수, medium=핵심만, low=선택적"
        },
        "human_approval_scope": {
          "type": "string",
          "enum": ["all", "numbers_only", "none"],
          "default": "numbers_only"
        },
        "disclosure_completeness_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9
        },
        "fallback_if_evidence_missing": {
          "type": "string",
          "enum": [
            "placeholder_with_query",
            "low_confidence_draft",
            "evidence_summary_only",
            "skip_with_note",
            "escalate"
          ],
          "default": "placeholder_with_query"
        },
        "placeholder_policy": {
          "type": "object",
          "properties": {
            "marker_format": {
              "type": "string",
              "default": "[확인필요: {reason}]"
            },
            "auto_register_query": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "approved": { "type": "boolean", "default": false }
      }
    }
  }
}
