{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sustainreport_ai/schemas/file_registry.schema.json",
  "$defs": {
    "file_entry": {
      "type": "object",
      "required": [
        "file_id",
        "original_filename",
        "file_type",
        "mime_type",
        "file_size_bytes",
        "content_hash",
        "ingestion_date",
        "source_path",
        "stage"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "pattern": "^F-\\d{4}$",
          "description": "고유 파일 ID"
        },
        "original_filename": {
          "type": "string",
          "description": "원본 파일명"
        },
        "file_type": {
          "type": "string",
          "description": "파일 확장자 (pdf, docx, xlsx, md, json 등)"
        },
        "mime_type": {
          "type": "string",
          "description": "MIME 타입"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "파일 크기 (바이트)"
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 해시값"
        },
        "ingestion_date": {
          "type": "string",
          "format": "date-time",
          "description": "투입 일시"
        },
        "source_path": {
          "type": "string",
          "description": "01_raw 내 경로"
        },
        "normalized_path": {
          "type": ["string", "null"],
          "description": "03_normalized_md 내 경로"
        },
        "stage": {
          "type": "string",
          "enum": ["raw", "normalized", "segmented", "bucketized", "archived"],
          "description": "현재 가공 단계"
        },
        "duplicate_of": {
          "type": ["string", "null"],
          "description": "중복 시 원본 파일 ID"
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "페이지 수"
        },
        "language": {
          "type": "string",
          "default": "ko",
          "description": "파일 언어"
        },
        "extracted_segments": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "pattern": "^SEG-\\d{5}$"
          },
          "description": "추출된 세그먼트 ID 목록"
        },
        "notes": {
          "type": ["string", "null"],
          "description": "메모"
        }
      }
    }
  },
  "type": "object",
  "required": ["registry_version", "project_id", "files"],
  "properties": {
    "title": {
      "type": "string",
      "description": "레지스트리 제목"
    },
    "registry_version": {
      "type": "string",
      "description": "레지스트리 스키마 버전"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-\\d{4}-[A-Z]+-\\d{3}$",
      "description": "프로젝트 ID"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_entry"
      },
      "description": "파일 목록"
    }
  }
}
